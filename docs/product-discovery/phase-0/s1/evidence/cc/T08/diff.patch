+/** "Hello, World!" → "hello-world". Optional maxLength cuts at a hyphen boundary. */
+export function slugify(text, { maxLength } = {}) {
+  const slug = String(text).normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+  if (maxLength === undefined || maxLength === null || slug.length <= maxLength) return slug;
+  const max = Math.max(0, maxLength);
+  // Cut is at a word boundary if the char after the cut is a hyphen.
+  let cut = slug[max] === "-" ? max : slug.lastIndexOf("-", max);
+  if (cut <= 0) cut = max; // first word alone is too long: hard cut
+  return slug.slice(0, cut).replace(/-+$/, "");
 }
