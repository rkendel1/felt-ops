+import { parseCSV } from "./csv.js";
+import { parseMoney } from "./money.js";
+
+/** Summarize invoice CSV (header `id,customer,amount`) into count, total and per-customer cents. */
+export function summarizeInvoices(csvText) {
+  const [, ...rows] = parseCSV(csvText);
+  const sums = new Map();
+  let totalCents = 0;
+  for (const [id, customer, amount] of rows) {
+    let cents;
+    try {
+      cents = parseMoney(amount);
+    } catch {
+      throw new Error(`Invalid amount for invoice ${id}: ${amount}`);
+    }
+    totalCents += cents;
+    sums.set(customer, (sums.get(customer) ?? 0) + cents);
+  }
+  return { count: rows.length, totalCents, byCustomer: Object.fromEntries(sums) };
+}
