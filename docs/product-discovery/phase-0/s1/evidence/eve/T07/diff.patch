+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { retry } from '../src/retry.js';
+
+test('onRetry called for retried failures only', async () => {
+  const calls = [];
+  await assert.rejects(
+    retry(async () => { throw new Error('x'); }, { attempts: 3, onRetry: (e, n) => calls.push(n) }),
+  );
+  assert.deepEqual(calls, [1, 2]);
+});
+
+test('retryable === false stops immediately', async () => {
+  let n = 0;
+  const err = Object.assign(new Error('fatal'), { retryable: false });
+  await assert.rejects(retry(async () => { n++; throw err; }, { attempts: 5 }), (e) => e === err);
+  assert.equal(n, 1);
+});
+
+test('factor scales delay', async () => {
+  const start = Date.now();
+  let n = 0;
+  await retry(async () => { if (++n < 3) throw new Error('x'); return 'ok'; }, { delayMs: 20, factor: 2 });
+  assert.ok(Date.now() - start >= 55);
+});
