+/** "Hello, World!" → "hello-world". Optional `maxLength` truncates at a hyphen boundary. */
+export function slugify(text, { maxLength } = {}) {
+  const slug = String(text).normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+  if (maxLength === undefined || maxLength === null || slug.length <= maxLength) return slug;
+  const limit = Math.max(0, Math.floor(maxLength));
+  // Cut at a hyphen boundary if the next char after the cut is a hyphen, or a hyphen exists within the limit.
+  if (slug[limit] === "-") return slug.slice(0, limit).replace(/-+$/, "");
+  const cut = slug.lastIndexOf("-", limit);
+  if (cut > 0) return slug.slice(0, cut);
+  return slug.slice(0, limit).replace(/-+$/, "");
 }
