--- fixture/src/csv.js	2026-11-23 13:49:42.315348727 +0000
+++ .ref/T02/src/csv.js	2026-11-23 13:51:03.743057564 +0000
@@ -1,6 +1,22 @@
 /** Parse CSV text into an array of rows (arrays of strings). Supports "quoted" fields. */
 export function parseCSV(text) {
-  return text.split(/\r?\n/).filter((line) => line.length > 0).map((line) =>
-    line.split(",").map((field) => field.replace(/^"(.*)"$/, "$1").replace(/""/g, '"')),
-  );
+  return text.split(/\r?\n/).filter((line) => line.length > 0).map(parseLine);
+}
+
+function parseLine(line) {
+  const fields = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < line.length; i++) {
+    const ch = line[i];
+    if (quoted) {
+      if (ch === '"' && line[i + 1] === '"') { field += '"'; i++; }
+      else if (ch === '"') quoted = false;
+      else field += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ",") { fields.push(field); field = ""; }
+    else field += ch;
+  }
+  fields.push(field);
+  return fields;
 }
