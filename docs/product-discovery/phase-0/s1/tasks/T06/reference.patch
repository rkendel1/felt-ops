diff -ruN fixture/src/query.js .ref/T06/src/query.js
--- fixture/src/query.js	2026-11-23 13:49:42.322418786 +0000
+++ .ref/T06/src/query.js	2026-11-23 13:51:03.743057564 +0000
@@ -1,15 +1,23 @@
-/** Parse "a=1&b=two" into { a: "1", b: "two" }. */
+const decode = (s) => decodeURIComponent(s.replace(/\+/g, " "));
+
+/** Parse "a=1&b=two" into { a: "1", b: "two" }; repeated keys become arrays. */
 export function parseQuery(qs) {
   const out = {};
   for (const part of qs.replace(/^\?/, "").split("&")) {
     if (!part) continue;
     const [k, v = ""] = part.split("=");
-    out[decodeURIComponent(k)] = decodeURIComponent(v);
+    const key = decode(k);
+    const value = decode(v);
+    if (!(key in out)) out[key] = value;
+    else if (Array.isArray(out[key])) out[key].push(value);
+    else out[key] = [out[key], value];
   }
   return out;
 }
 
-/** Serialize { a: "1", b: "two" } into "a=1&b=two". */
+/** Serialize { a: "1", b: ["x", "y"] } into "a=1&b=x&b=y". */
 export function stringifyQuery(obj) {
-  return Object.entries(obj).map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join("&");
+  return Object.entries(obj)
+    .flatMap(([k, v]) => (Array.isArray(v) ? v : [v]).map((x) => `${encodeURIComponent(k)}=${encodeURIComponent(x)}`))
+    .join("&");
 }
