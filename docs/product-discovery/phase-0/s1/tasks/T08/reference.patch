+/** "Hello, World!" → "hello-world". With maxLength, cut at a word boundary when possible. */
+export function slugify(text, { maxLength } = {}) {
+  const slug = String(text).normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+  if (maxLength === undefined || slug.length <= maxLength) return slug;
+  const cut = slug.slice(0, maxLength + 1);
+  const boundary = cut.lastIndexOf("-");
+  const out = boundary > 0 ? cut.slice(0, boundary) : slug.slice(0, maxLength);
+  return out.replace(/-+$/, "");
 }
