diff -ruN fixture/src/table.js .ref/T09/src/table.js
--- fixture/src/table.js	2026-11-23 13:49:42.327043988 +0000
+++ .ref/T09/src/table.js	2026-11-23 13:51:03.743057564 +0000
@@ -1,9 +1,15 @@
-/** Render rows (objects with the same keys) as a Markdown table. */
-export function renderTable(rows) {
+const DIVIDER = { left: ":---", right: "---:", center: ":---:" };
+
+/** Render rows (objects with the same keys) as a Markdown table. Numeric columns align right by default. */
+export function renderTable(rows, { align } = {}) {
   if (rows.length === 0) return "";
   const columns = Object.keys(rows[0]);
   const header = `| ${columns.join(" | ")} |`;
-  const divider = `| ${columns.map(() => "---").join(" | ")} |`;
+  const divider = `| ${columns.map((c) => {
+    if (align && align[c]) return DIVIDER[align[c]] ?? "---";
+    if (!align && rows.every((r) => typeof r[c] === "number")) return "---:";
+    return "---";
+  }).join(" | ")} |`;
   const body = rows.map((row) => `| ${columns.map((c) => String(row[c] ?? "")).join(" | ")} |`);
   return [header, divider, ...body].join("\n");
 }
