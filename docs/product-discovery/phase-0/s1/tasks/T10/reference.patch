@@ -0,0 +1,16 @@
+import { parseCSV } from "./csv.js";
+import { parseMoney } from "./money.js";
+
+/** Summarize an invoices CSV (header id,customer,amount). */
+export function summarizeInvoices(csvText) {
+  const [, ...rows] = parseCSV(csvText);
+  const byCustomer = {};
+  let totalCents = 0;
+  for (const [id, customer, amount] of rows) {
+    let cents;
+    try { cents = parseMoney(amount); } catch { throw new Error(`Invoice ${id}: cannot parse amount "${amount}"`); }
+    byCustomer[customer] = (byCustomer[customer] ?? 0) + cents;
+    totalCents += cents;
+  }
+  return { count: rows.length, totalCents, byCustomer };
+}
